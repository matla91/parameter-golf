RUN_ID=int8_lzma9_colrot
DATA_PATH=./data/datasets/fineweb10B_sp1024
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

# -----------------------------
# COMPRESSION
# -----------------------------
COMPRESSION=lzma
LZMA_PRESET=9

# -----------------------------
# ROTATION COLONNE (NOUVEAU)
# -----------------------------
INT8_ROTATE_COLUMN_2D=1
INT8_ROTATE_SEED=1337

# fallback si dimension ≠ power of 2
# (512, 1024 OK → Hadamard)
# autres → QR
INT8_ROTATE_NON_POWER2_FALLBACK=qr

# -----------------------------
# TRAINING / CLUSTER
# -----------------------------
MAX_WALLCLOCK_SECONDS=0
COMPILE_MODEL=1
COMPILE_MUON=1

TRAIN_LOG_EVERY=200
VAL_LOSS_EVERY=1000

# -----------------------------
# NCCL / DEBUG
# -----------------------------
NCCL_DEBUG=INFO
NCCL_IB_DISABLE=1
PYTHONUNBUFFERED=1