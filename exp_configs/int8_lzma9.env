RUN_ID=int8_lzma9
DATA_PATH=./data/datasets/fineweb10B_sp1024
TOKENIZER_PATH=./data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

# Tes variables de compression (assure-toi que ton train_gpt_dev.py 
# les lit bien avec os.environ.get(), sinon c'est ignoré !)
COMPRESSION=lzma
LZMA_PRESET=9

# Variables système CRITIQUES pour le cluster
MAX_WALLCLOCK_SECONDS=0
COMPILE_MODEL=1
COMPILE_MUON=1
TRAIN_LOG_EVERY=200
VAL_LOSS_EVERY=1000

# Debugging et fix réseau
NCCL_DEBUG=INFO
NCCL_IB_DISABLE=1
PYTHONUNBUFFERED=1