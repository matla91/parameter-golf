# Adapted to the user's current Parameter Golf setup on cluster.
# This keeps the SOTA-like script but points it to the existing SP1024 dataset/tokenizer.

RUN_ID=follow_sota_sp1024
DATA_PATH=/scratch/matla/ml_projects/datasets/parameter_golf/fineweb10B_sp1024
TOKENIZER_PATH=/scratch/matla/ml_projects/parameter-golf/data/tokenizers/fineweb_1024_bpe.model
VOCAB_SIZE=1024

ITERATIONS=20000
WARMUP_STEPS=20
MAX_WALLCLOCK_SECONDS=600
TRAIN_BATCH_TOKENS=786432
TRAIN_SEQ_LEN=2048
VAL_BATCH_TOKENS=524288
EVAL_SEQ_LEN=2048
VAL_LOSS_EVERY=4000
TRAIN_LOG_EVERY=500
WARMDOWN_FRAC=0.72

NUM_LAYERS=11
MODEL_DIM=512
EMBEDDING_DIM=512
NUM_HEADS=8
NUM_KV_HEADS=4
MLP_MULT=4.0
TIE_EMBEDDINGS=1
SKIP_GATES_ENABLED=1
XSA_LAST_N=11
ROPE_BASE=10000
ROPE_DIMS=16
ROPE_TRAIN_SEQ_LEN=2048
QK_GAIN_INIT=5.0
NUM_LOOPS=2
LOOP_START=3
LOOP_END=5
ENABLE_LOOPING_AT=0.35
PARALLEL_RESIDUAL_START=7
LN_SCALE=1
LOGIT_SOFTCAP=30.0

EMBED_LR=0.6
HEAD_LR=0.008
TIED_EMBED_LR=0.03
TIED_EMBED_INIT_STD=0.005
MATRIX_LR=0.022
SCALAR_LR=0.02
MIN_LR=0.0
MUON_MOMENTUM=0.99
MUON_BACKEND_STEPS=5
MUON_MOMENTUM_WARMUP_START=0.92
MUON_MOMENTUM_WARMUP_STEPS=1500
MUON_ROW_NORMALIZE=1
MUON_BETA2=0.95
BETA1=0.9
BETA2=0.95
ADAM_EPS=1e-8
GRAD_CLIP_NORM=0.3
ADAM_WD=0.02
MUON_WD=0.095
EMBED_WD=0.085
EMA_DECAY=0.9965
EVAL_STRIDE=64

COMPRESSOR=brotli
GPTQ_CALIBRATION_BATCHES=64
GPTQ_RESERVE_SECONDS=12
MATRIX_BITS=6
EMBED_BITS=8
MATRIX_CLIP_SIGMAS=12.85
EMBED_CLIP_SIGMAS=20.0

TTT_ENABLED=0
ETLB_ENABLED=0
